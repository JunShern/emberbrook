node_modules/
.DS_Store
.env
__pycache__/
*.blend1
tools/blends/backups/
public/assets/scenes/townwalk/.staging/
public/assets/scenes/townwalk/.last_master_mtime
public/assets/scenes/townwalk/meta.json
public/assets/scenes/gate-branch/
public/assets/scenes/townwalk/.last_blend_mtime
*.blend1

# dressing library: source scans are cached, never committed (see
# public/assets/dressing/fetch.json for the sha256 pins)
tools/asset_cache/

# cut-in STUDIO PLATES: the flat-key source art tools/gen-cutin-art.mjs draws,
# ~2 MB x 138. What ships is the matte (cutin*.png) — the same drawing minus a
# colour nobody sees — and this repo is already 6.6 GB with a push that has died
# on GitHub's pack limit once. Losing one costs a re-roll of that one plate;
# tools/characters/cutins.spec.json is what makes the re-roll a single command.
public/assets/characters/*/studio/
dist/
dist-c/
# any build output: the deploy build is produced, never committed
dist-*/

# Working scratch. Probe scripts, one-off JSON dumps, partial logs — never an
# input to anything (tools name scratchpad/ only as a write target). It sat untracked
# AND unignored until 2026-08-02, so 128 files of dead probe output showed in every
# `git status`, which is exactly the clutter the cleanup was asked to remove.
scratchpad/

# the static build encode cache (tools/build-static.mjs). Derived bytes, keyed by
# sha256(source)+sha256(encode params) — regenerable, and hundreds of MB.
.build-cache/

# PLAYTEST RUNS. Every llm_playtester run writes a directory of frames + jsonl;
# 24 of them accumulated in a day and 19 were pure churn in `git status`.
# NOTE: .gitignore does not touch already-tracked files, so the runs the FIXLOG
# cites as EVIDENCE for a bug report stay in git exactly as they are. When a new
# run is the evidence for a finding, commit it deliberately with `git add -f` —
# that is the point: evidence is a decision, not a side effect of running a test.
docs/qa/playtest/runs/
